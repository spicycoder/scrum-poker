# Scrum Poker - Portainer config
# Copy this to Portainer stack env vars

# Host ports
PORT=1800
WEB_PORT=1801
API_PORT=1802

# Redis connection
REDIS_CONNECTION=redis:6379

# Image tags (latest = CI build from master branch)
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest

# Game room TTL (seconds, 5400 = 90 min)
GAME_EXPIRATION=5400
